<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="mx-auto mt-4 max-w-xl sm:mt-6">
  <input
    type="hidden"
    name="access_key"
    value="de869032-9efb-4bbf-9462-756923ccc356"
  />
  <input type="hidden" name="subject" value="New Submission!" />
  <input type="hidden" name="from_name" value="pgse.co.uk" />
  <input type="hidden" name="redirect" value="https://www.pgse.co.uk/thanks" />

  <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
    <div>
      <label
        for="first-name"
        class="block text-sm font-semibold leading-6 text-primary-900">
        First name <span class="text-xs text-primary-400">(required)</span>
      </label>
      <div class="mt-2.5">
        <input
          type="text"
          name="first-name"
          id="first-name"
          autocomplete="given-name"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
          required
        />
      </div>
    </div>
    <div>
      <label
        for="last-name"
        class="block text-sm font-semibold leading-6 text-primary-900">
        Last name <span class="text-xs text-primary-400">(required)</span>
      </label>
      <div class="mt-2.5">
        <input
          type="text"
          name="last-name"
          id="last-name"
          autocomplete="family-name"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
          required
        />
      </div>
    </div>
    <div class="sm:col-span-2">
      <label
        for="company"
        class="block text-sm font-semibold leading-6 text-primary-900">
        Company
      </label>
      <div class="mt-2.5">
        <input
          type="text"
          name="company"
          id="company"
          autocomplete="organization"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
        />
      </div>
    </div>
    <div class="sm:col-span-2">
      <label
        for="email"
        class="block text-sm font-semibold leading-6 text-primary-900">
        Email <span class="text-xs text-primary-400">(required)</span>
      </label>
      <div class="mt-2.5">
        <input
          type="email"
          name="email"
          id="email"
          autocomplete="email"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
          required
        />
      </div>
    </div>
    <div class="sm:col-span-2">
      <label
        for="subject"
        class="block text-sm font-semibold leading-6 text-primary-900">
        Subject (or Project Address) <span class="text-xs text-primary-400">
          (required)
        </span>
      </label>
      <div class="mt-2.5">
        <input
          type="text"
          name="subject"
          id="subject"
          autocomplete="subject"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
          required
        />
      </div>
    </div>
    <div class="sm:col-span-2">
      <label
        for="message"
        class="block text-sm font-semibold leading-6 text-primary-900">
        Message <span class="text-xs text-primary-400">(required)</span>
      </label>
      <div class="mt-2.5">
        <textarea
          name="message"
          id="message"
          rows="4"
          class="block w-full rounded-md border-0 bg-primary-100 px-3.5 py-2 text-primary-900 shadow-sm ring-1 ring-inset ring-primary-300 placeholder:text-primary-400 focus:ring-1 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
          placeholder="A brief description of your project or inquiry"
          required></textarea>
      </div>
    </div>
  </div>
  <div class="mt-10">
    <button
      type="submit"
      class="block w-full rounded-md bg-primary-800 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-secondary-600 delay-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
      SUBMIT
    </button>
  </div>
</form>
<script is:inline src="https://web3forms.com/client/script.js" async defer>
</script>
