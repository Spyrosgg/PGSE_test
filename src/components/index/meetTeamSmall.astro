---
import { Image } from "astro:assets";
import profileA from "../../images/profiles/SpyrosSmall.jpeg";
import profileB from "../../images/profiles/DiogoSmall.jpeg";
import { SITE_TITLE_HEADER } from "../../consts";
// import profilePicA from "../../assets/profileA.png";
// import profilePicB from "../../assets/profileB.png";
---

<!-- Meet the team -->
<div class="mx-auto grid max-w-7xl gap-x-8 gap-y-20 xl:grid-cols-3">
  <div class="max-w-2xl">
    <h2 class="text-xl tracking-tight sm:text-2xl">Meet our team</h2>
    <p class="mt-2">
      Building on 20+ years of engineering expertise. &nbsp;
      <a
        class="inline-flex justify-center text-sm font-semibold text-primary-800 hover:text-primary-400"
        href="/about"
      >
        Learn more &nbsp;<span
          aria-hidden="true"
          class="text-primary/50 sm:inline">→</span
        >
      </a>
    </p>
  </div>
  <ul
    role="list"
    class="grid gap-x-8 gap-y-12 sm:grid-cols-2 sm:gap-y-16 xl:col-span-2"
  >
    <!-- People -->
    <li>
      <a href="/about#meet-our-team" class="flex items-center gap-x-6">
        <!-- <Image class="h-24 w-24 rounded-full" src={profilePicB} alt="Spyros" /> -->
        <Image
          class="h-24 w-24 rounded-full"
          src={profileA}
          alt="Spyros"
          width={620}
        />
        <div>
          <h2 class="text-xl">Spyros Gavriilidis</h2>
          <p class="mb-1 text-sm font-semibold text-primary-800">CEng MICE</p>
          <p class="text-sm font-semibold text-secondary-700">
            Civil & Structural Engineer
          </p>
          <p class="mb-3 text-sm font-semibold text-secondary-700">Partner</p>
        </div>
      </a>
      <li>
        <a href="/about#meet-our-team" class="flex items-center gap-x-6">
          <!-- <Image class="h-24 w-24 rounded-full" src={profilePicA} alt="Spyros" /> -->
          <Image
            class="h-24 w-24 rounded-full"
            src={profileB}
            alt="Diogo"
            width={620}
          />
          <div>
            <h2 class="text-xl">Diogo Pereira</h2>
            <p class="mb-1 text-sm font-semibold text-primary-800">CEng MICE</p>
            <p class="text-sm font-semibold text-secondary-700">
              Civil & Structural Engineer
            </p>
            <p class="mb-3 text-sm font-semibold text-secondary-700">Partner</p>
          </div>
        </a>

        <!-- More people... -->
      </li>
    </li>
  </ul>
</div>
