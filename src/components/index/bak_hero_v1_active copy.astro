---
import { Image } from "astro:assets";
// import bridge from "../../images/bridge-full2.png";
import bridge from "../../images/bridge.png";
import houses from "../../images/residential_hero.jpeg";
import BtnContact2 from "../ui/btn-contact_v2.astro";
const hHero = 1;
---

<section class="bg-whitez h-[calc(100vh-30px)]">
  <div class="relative">
    <Image
      class="absolute -z-20 h-[calc(100vh-30px)] -top-[80px] w-auto md:right-0 object-[65%_50%] md:object-[70%_50%] object-cover"
      src={bridge}
      height={1080}
      alt="bridge"
    />

    <div
      class="ml-6 h-12 pt-16 sm:pt-[15vh] sm:ml-16 md:ml-[15vw] lg:ml-[25vw] z-50">
      <h1
        class="text-4xl font-bold tracking-tight text-primary-800 sm:text-6xl">
        Engineering a <br />
         brighter Future, <br />
        <span class="text-secondary-700">Together</span>
      </h1>
      <p class="pt-6 sm:text-xl max-w-[270px] sm:max-w-sm">
        We are an energetic team of design-oriented structural
        engineers.
      </p>
      <BtnContact2 />
    </div>

    {/*Triangle */}
    <!-- <div
    class="absolute -top-[500px] left-0 w-0 h-0 border-t-[500px] border-t-transparent border-l-[100vw] border-l-zinc-300 border-b-[80vh] border-b-transparent opacity-50 -z-10">
  </div> -->
  </div>
</section>
