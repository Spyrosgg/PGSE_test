---
import { withBase } from "../../lib/url.js";
import { Image } from "astro:assets";
// import bridge from "../../images/bridge-full2.png";
import bridge from "../../images/bridge.png";
import EDA from "../../images/eda-diff.png";
import EDAmba from "../../images/eda-mba.png";
import houses from "../../images/residential_hero.jpeg";
---

<section class="h-[100vh + 100px]">
  <div class="flex flex-col items-center pt-16">
    <h1
      class="px-2 text-center text-4xl font-bold tracking-tight text-primary-800 sm:text-5xl md:text-6xl lg:w-2/3">
      Engineering a <br /> Better Future, <span class="text-secondary-600">
        Together
      </span>
    </h1>

    {/*Triangle */}
    <!-- <div
      class="absolute -top-[450px] left-0 -z-50 h-0 w-0 border-b-[80vh] border-l-[100vw] border-t-[500px] border-b-transparent border-l-primary-500 border-t-transparent opacity-10">
    </div> -->

    <div class="flex w-2/3 flex-col items-center pt-4">
      <p class="text-center text-primary-800 sm:text-lg">
        We are an energetic team of design-oriented chartered structural
        engineers. Our extensive experience and expertise empower you to bring
        your vision to life.
      </p>

      <div class="mt-8">
        <button class="relative">
          <a
            class="relative rounded-full bg-primary-200 px-4 py-3 text-sm font-semibold text-primary-600 hover:bg-secondary-600 hover:text-white hover:delay-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
            href={withBase("/contact")}>
            Get a quick inquiry
          </a>
        </button>
      </div>
    </div>

    <div class="relative flex flex-col items-center px-6 pt-8">
      <!-- <div class="text-center text-lg font-semibold text-primary-800">
        ENGINEERS DESIGNERS ADVISERS
      </div> -->
      <Image
        class="center relative left-1/2 -z-20 hidden h-[500px] w-[800px] -translate-x-1/2 rounded-tr-[2rem] object-cover md:block"
        src={EDA}
        alt="bridge"
        sizes="(max-width: 800px) 100vw"
      />
      <Image
        class="center relative left-1/2 -z-20 h-[500px] w-[800px] -translate-x-1/2 rounded-xl object-cover md:hidden"
        src={EDAmba}
        alt="bridge"
        sizes="(max-width: 800px) 100vw"
      />
    </div>
  </div>
</section>
