---
import { Image } from "astro:assets";
const { picture, type, alt, reverse, servicesItems } = Astro.props;
/* Reverse boolean switches flex-row and rounded corners use a ternary operator */
import { Debug } from "astro:components";
---

<div
  class:list={[
    reverse ? "md:flex-row-reverse" : "md:flex-row",
    "flex flex-col md:justify-center",
  ]}
>
  <!-- <div class="flex flex-col md:flex-row md:justify-start"> -->
  <div class=" relative flex justify-center">
    <h1
      class:list={[
        reverse
          ? "md:rounded-r-2xl rounded-t-2xl md:rounded-tl-none"
          : "md:rounded-l-2xl rounded-t-2xl md:rounded-tr-none",
        "absolute top-0 left-0 right-0 bottom-0 flex items-center justify-center text-5xl font-bold text-white bg-primary-900/30",
      ]}
    >
      {type}
    </h1>
    <Image
      class:list={[
        reverse
          ? "md:rounded-r-2xl rounded-t-2xl md:rounded-tl-none"
          : "md:rounded-l-2xl rounded-t-2xl md:rounded-tr-none",
        "-z-10 relative h-52 md:h-full overflow-hidden object-cover",
      ]}
      src={picture}
      width={800}
      alt={alt}
    />
  </div>
  <div
    class:list={[
      reverse
        ? "md:rounded-l-2xl rounded-b-2xl md:rounded-br-none"
        : "md:rounded-r-2xl rounded-b-2xl md:rounded-bl-none",
      "flex flex-col  justify-center bg-primary-800 text-white md:w-[500px] md:max-w-md md:min-w-[300px] p-6 pl-8 inline-block ",
    ]}
  >
    <ul class="list-none pt-4 divide-y-[1px] divide-primary-400/50">
      {
        servicesItems.map(({ title }) => (
          <li class="font-bold px-2 py-1 hover:delay-100 hover:bg-primary-500/20">{title}</li>
        ))
      }
    </ul>
  </div>
</div>
