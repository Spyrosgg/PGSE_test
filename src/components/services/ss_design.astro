---
import { Image } from "astro:assets";
import bimimg from "../../images/bim.jpeg";
---

<div class="flex flex-col md:flex-row-reverse md:justify-center">
  <!-- <div class="flex flex-col md:flex-row-reverse md:justify-start"> -->
  <div class="flex md:max-w-lg relative">
    <h1
      class="md:rounded-r-2xl absolute top-0 left-0 right-0 bottom-0 flex justify-center items-center text-5xl font-bold text-white bg-primary-900/20"
    >
      Design
    </h1>
    <Image
      class="md:rounded-r-2xl md:min-h-[350px] max-h-32 overflow-hidden object-cover"
      src={bimimg}
      width={800}
      alt="bim"
    />
  </div>
  <div
    class="bg-primary-800 text-white md:w-[400px] max-w-md min-w-[270px] p-6 pl-8 inline-block md:rounded-l-2xl"
  >
    <ul class="list-disc pt-4">
      <li class="font-bold">BIM modelling</li>
      <li class="font-bold">Finite Element modelling (FEM)</li>
      <li class="font-bold">Parametric design</li>
      <li class="font-bold">3D modelling</li>
      <li class="font-bold">CAD drawings</li>
      <li class="font-bold">Clash detection</li>
    </ul>
  </div>
</div>
