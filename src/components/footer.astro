---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import {
  OFFICIAL_TITLE,
  SITE_TITLE_HEADER,
  SITE_SUB_TITLE,
  EMAIL,
} from "../consts";

import logoICE from "../images/logo/logo-ice.png";
import logoTEE from "../images/logo/logo-tee.png";
import logoETEK from "../images/logo/logo-etek.png";
import logoODE from "../images/logo/logo-ode.png";
// const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class="sticky top-[100vh] scroll-smooth z-30">
  <div
    class="relative mx-auto grid grid-cols-1 justify-items-center bg-primary-200 sm:grid-cols-5 px-8 py-16 sm:py-24"
  >
    <!-- 1 -->
    <div class="flex flex-col gap-3 items-center sm:items-start">
      <div class="text-2xl">
        <span class="text-primary-800 font-semibold">
          <!-- {SITE_TITLE_HEADER} --> ℙ𝔾𝕊𝔼
        </span>
      </div>
      <!-- linkedin -->
      <div class="flex gap-1">
        <a
          href="https://www.linkedin.com/company/PGSEglobal"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="linkedin page"
        >
          <Icon
            name="entypo-social:linkedin-with-circle"
            class="h-8 w-8 text-primary-800"
          />
        </a>
        <!-- facebook -->
        <a
          href="https://www.facebook.com/PGSEglobal"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="facebook page"
        >
          <Icon
            name="entypo-social:facebook-with-circle"
            class="h-8 w-8 text-primary-800"
          />
        </a>
        <!-- x.com -->
        <!-- <a
          href="https://www.twitter.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-primary-800 p-1 text-lg text-primary-200 flex justify-center items-center"
          >𝕏
        </a> -->
        <!-- email -->
        <a
          href=`mailto:info@pgse.co.uk`
          target="_blank"
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full p-2 bg-primary-800 flex justify-center items-center"
          aria-label="email"
        >
          <Icon name="entypo:mail" class="h-8 w-8 text-primary-200" />
        </a>
      </div>

      <a class="text-xl font-light" href=`mailto:info@pgse.co.uk`
        >info@{EMAIL}</a
      >
    </div>
    <div></div>
    <!-- 2 -->
    <div class="w-[112px]">
      <div class="p-2"></div>
      <a class="inline-block p-6 text-xl font-bold " href="#" aria-label="go to top"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-16 w-16 fill-primary-800"
        >
          <path
            fill-rule="evenodd"
            d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm.53 5.47a.75.75 0 00-1.06 0l-3 3a.75.75 0 101.06 1.06l1.72-1.72v5.69a.75.75 0 001.5 0v-5.69l1.72 1.72a.75.75 0 101.06-1.06l-3-3z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>

    <!-- 3 -->
    <div class="flex justify-items-center col-span-2">
      <div class="flex flex-wrap justify-center items-center gap-4">
        <Image
          class="w-auto object-contain"
          src={logoICE}
          height={65}
          alt="chamber-logos"
        />
        <Image
          class="w-auto object-contain"
          src={logoODE}
          height={65}
          alt="chamber-logos"
        />
        <Image
          class="w-auto object-contain"
          src={logoTEE}
          height={65}
          alt="chamber-logos"
        />
        <Image
          class="w-auto object-contain"
          src={logoETEK}
          height={65}
          alt="chamber-logos"
        />
      </div>
      <!-- old qualifications -->
      <!-- <div
        class="flex flex-col items-center border border-secondary-100 bg-cyan-600 p-2 text-white"
      >
        <p class="font-display text-2xl">ICE</p>
        <p class="mt-0 text-sm border-t-2">Membership</p>
      </div>
      <div>
        <Image class="mt-4 w-20" src={etek} alt="etek-logo" width={127} />
        <p class="text-xs text-primary-500">
          Cyprus Scientific <br /> Technical Chamber
        </p>
      </div>
      <div>
        <Image
          class="mt-4 ml-1"
          src={odep}
          alt="etek-logo"
          width={97}
          height={124}
        />
      </div>
    </div> -->
    </div>
  </div>
  <div
    class="flex justify-center gap-4 bg-primary-300 p-4 px-6 py-2 pt-4 text-xs text-primary-600 sm:grid-cols-2 sm:justify-start"
  >
    © 2023 {OFFICIAL_TITLE} ltd | All rights reserved.
  </div>
</footer>
