---
const { arrowOff, text = "Our services" } = Astro.props;
---

<button class="flex flex-col items-end shrink-0">
  <a
    class="inline-flex justify-center
   rounded-full bg-primary-100 px-4 py-3 text-sm font-semibold text-primary-800 ring-1 ring-primary-300 hover:bg-primary-200"
    href="/services"
  >
    {text}
    <span aria-hidden="true" class:list={["text-primary/50", arrowOff]}>&nbsp;→</span>
  </a>
</button>
