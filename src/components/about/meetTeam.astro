---
import { withBase } from "../../lib/url.js";
import { Image } from "astro:assets";
import { SITE_TITLE_HEADER } from "../../consts";
import profileA from "../../images/profiles/SpyrosSmall.jpeg";
import profileB from "../../images/profiles/DiogoSmall.jpeg";
import { Icon } from "astro-icon/components";

// import profilePicA from "../../assets/profileA.png";
// import profilePicB from "../../assets/profileB.png";
---

<h2 id="meet-our-team" class="border-b-2 text-2xl">Meet Our Team</h2>

<ul class="mt-8 grid justify-center items-start gap-8 sm:grid-cols-2">
  <li class="profileB flex flex-col items-center">
    <Image
      class="m-auto mb-1 h-auto max-w-[15rem] rounded-full p-4 sm:p-8 md:max-w-xs"
      src={profileA}
      alt="Spyros"
      width={620}
    />
    <div class="max-w-full flex flex-col items-center justify-center">
      <h2 class="text-xl">
        Spyros Gavriilidis <span class="text-sm">CEng MICE</span>
      </h2>
      <p class="text-sm font-semibold leading-6 text-secondary-600">
        Civil & Structural Engineer
      </p>
      <!-- <p class="text-sm font-semibold leading-6 text-secondary-600">
        BIM manager
      </p> -->
      <p
        class="mb-3 flex items-end gap-2 text-sm font-semibold text-secondary-600">
        Partner
        <a
          href="https://www.linkedin.com/in/spyrosgavriilidis"
          target="_blank"
          rel="noopener noreferrer">
          <Icon name="mdi:linkedin" class="h-6 w-6 text-secondary-600" />
        </a>
      </p>
    </div>
    <p>
      <p>
        Spyros is a chartered engineer with extended experience of new-build,
        refurbishment and extension projects in several sectors such as
        high-rise and retail buildings, rail, educational, healthcare, commercial and
        residential structures. He has a strong engineering knowledge and
        attention to detail which enables him to effectively identify design and
        commercial opportunities to create efficiencies and add value to
        projects. He also specialises in BIM and automation development, looking
        to drive innovation in the engineering field. This enables him to
        increase team productivity and successfully deliver significant projects
        on tight schedules.
        <a
          class="mb-3 flex items-end gap-2 font-semibold text-secondary-600"
          href={withBase("/spyros-gavriilidis/")}>
          Learn more
        </a>
      </p>
    </p>
  </li>

  <li class="profileA flex flex-col items-center">
    <Image
      class="m-auto mb-1 h-auto max-w-[15rem] rounded-full p-4 sm:p-8 md:max-w-xs"
      src={profileB}
      alt="Diogo"
      width={620}
    />
    <div class="max-w-full flex flex-col items-center justify-center">
      <h2 class="text-xl">
        Diogo Pereira <span class="text-sm">CEng MICE</span>
      </h2>
      <p class="text-sm font-semibold leading-6 text-secondary-600">
        Civil & Structural Engineer
      </p>
      <!-- <p class="text-sm font-semibold leading-6 text-secondary-600">
        Project manager
      </p> -->
      <p
        class="mb-3 flex items-end gap-2 text-sm font-semibold text-secondary-600">
        Partner
        <a
          href="https://www.linkedin.com/in/d10gopereira/"
          target="_blank"
          rel="noopener noreferrer">
          <Icon name="mdi:linkedin" class="h-6 w-6 text-secondary-600" />
        </a>
      </p>
    </div>
    <p>
      Diogo is a chartered engineer with extensive expertise in the structural
      design of buildings, bridges, and tunnels. He has accumulated valuable
      international experience in the UK, Portugal, Libya, and Greece, leading
      multidisciplinary teams in the design of small to very large-scale
      projects. This cross-cultural experience allows him to successfully
      collaborate with clients, stakeholders, third-party designers, and
      contractors to deliver the best possible designs on budget and on time.
      Diogo is passionate about working with clients to understand their vision
      allowing him to deliver quality and efficient designs.
      <a
        class="mb-3 flex items-end gap-2 font-semibold text-secondary-600"
        href={withBase("/diogo-pereira/")}>
        Learn more
      </a>
    </p>
  </li>
</ul>
