---
import { withBase } from "../../lib/url.js";
import { Icon } from "astro-icon/components";
import {  SITE_TITLE_HEADER } from "../../consts";

/** Main menu items */
const navItems = [
  /* { title: "Why PGSE", url: withBase("/why_pgse/") }, */
  { title: "About us", url: withBase("/about/") },
  { title: "Services", url: withBase("/services/") },
  { title: "Experience", url: withBase("/experience/") },
  { title: "Contact", url: withBase("/contact/") },
];
---

<header id="nav-header" class="z-50">
  <nav
    class="mx-auto flex items-center justify-between p-4 md:px-12"
    aria-label="Global">
    <!-- Logo -->
    <a href={withBase("/")} class="-m-1.5 p-1.5">
      <div class="flex items-center">
        {/*LOGO */}
        <!-- <img class="w-7 h-7 mr-2 transform rotate-45" src={withBase("/MdiGrid.svg")} alt="logo" /> -->

        <div class="flex flex-col lg:flex-1">
          <span class="sr-only">{SITE_TITLE_HEADER}</span>
          <div class="w-auto text-xl">
            <span class="font-display text-5xl font-bold text-primary-800"
              >{SITE_TITLE_HEADER}</span
            >
          </div>
          <!-- <p class="text-sm leading-4 text-primary-600">engineering elegance</p> -->
          <div
            class="h-6 w-auto text-[0.78rem] font-semibold leading-3 text-primary-800">
            StructuralEngineers
          </div>
        </div>
      </div>
    </a>

    <!-- hamburger button -->
    <div class="flex md:hidden">
      <button
        id="open-nav-btn"
        type="button"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700">
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
    <!-- Menu large -->
    <div class="menu hidden md:flex md:gap-x-4">
      {
        navItems.map(({ title, url }) => (
          <a
            class="rounded-full px-3 py-2  font-semibold leading-6 text-primary-600 hover:bg-primary-200"
            href={url}>
            {title}
          </a>
        ))
      }
      <!-- <a class="text-sm font-semibold leading-6 rounded-lg px-2 py-1 bg-primary-800 text-primary-100 hover:bg-primary-700" href=/contact>
        CONTACT
      </a> -->
    </div>
  </nav>

  <!-- Mobile menu, show/hide based on menu open state. -->
  <div
    id="menu-mobile"
    class="hidden md:hidden"
    role="dialog"
    aria-modal="true">
    <!-- Background backdrop, show/hide based on slide-over state. -->
    <div class="fixed inset-0 z-20"></div>
    <div
      class="fixed inset-y-0 right-0 z-20 w-full overflow-y-auto bg-primary-200 px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
      <div class="flex items-center justify-between">
        <a href={withBase("/")} class="-m-1.5 p-1.5">
          <span class="sr-only">{SITE_TITLE_HEADER}</span>
          <div class="h-6 w-auto text-xl font-semibold">{SITE_TITLE_HEADER}</div>
        </a>
        <button
          id="close-nav-btn"
          type="button"
          class="-m-2.5 rounded-md p-2.5 text-gray-700">
          <span class="sr-only">Close menu</span>
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-gray-500/10">
          <div class="space-y-2 py-6">
            <div class="-mx-3">
              {
                navItems.map(({ title, url }) => (
                  <a
                    class="-mx-3 block rounded-lg px-4 py-2 text-base font-semibold leading-7 text-primary-900 hover:bg-primary-100"
                    href={url}>
                    {title}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector("#menu-mobile");
  const openNavButton = document.querySelector("#open-nav-btn");
  const closeNavButton = document.querySelector("#close-nav-btn");

  const toggleMenu = () => {
    menu.classList.toggle("hidden");
  };

  openNavButton.addEventListener("click", toggleMenu);
  closeNavButton.addEventListener("click", toggleMenu);
</script>
