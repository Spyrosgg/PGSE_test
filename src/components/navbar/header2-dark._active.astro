---
import { withBase } from "../../lib/url.js";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE_TITLE_HEADER } from "../../consts";
import logo1 from "../../../public/PGSE_v2.jpg";

const activePage = Astro.url.pathname.toString();

/** Main menu items */
const navItems = [
  { title: "About us", url: withBase("/about/") },
  /*   { title: "Why PGSE", url: withBase("/why_pgse/") }, */
  /*   { title: "About us", url: withBase("/about/") }, */
  { title: "Services", url: withBase("/services/") },
  { title: "Experience", url: withBase("/experience/") },
  { title: "Contact", url: withBase("/contact/") },
];
---

<header id="nav-header " class="z-50 w-full">
  <nav
    class="mx-auto flex z-100 items-center justify-between md:justify-center p-4 md:px-12 md:gap-x-32"
    aria-label="Global">
    <div
      class="absolute top-0 left-0 bg-primary-200/50 -z-10 md:h-[70px] h-[56px] w-[100vw]">
    </div>
    <!-- Menu Left -->
    <div class="menu hidden md:flex">
      {
        navItems
          .map(({ title, url }) => (
            <a
              class="group shrink-0 px-4 py-2 font-semibold leading-6 text-primary-700 duration-300"
              href={url}>
              {title}
              <span
                class:list={[
                  "block max-w-0 group-hover:max-w-full transition-all duration-500 h-1 bg-secondary-600",
                  activePage == url ? "max-w-full" : "",
                ]}
              />
            </a>
          ))
          .slice(0, 2)
      }
    </div>

    <!-- Logo -->
    <a href={withBase("/")} class="-m-1.5 p-1.5">
      {/*LOGO */}
      <span class="sr-only">{SITE_TITLE_HEADER}</span>
      <!-- <Image
      class=""
      src={logo1}
      width={100}
      height={100}
      alt="structures"
    /> -->
      <div
        class="w-20 h-20 font-display text-3xl rounded-full font-bold text-white bg-primary-800">
        <div class="grid grid-cols-2">
          <div class="w-10 h-10 relative top-2 left-5">P</div>
          <div class="w-10 h-10 relative top-2 left-0.5">G</div>
          <div class="w-10 h-10 relative bottom-1 left-5">S</div>
          <div class="w-10 h-10 relative bottom-1 left-1">E</div>
        </div>
      </div>
      <!-- <p>{canonicalURL},url</p -->
    </a>
    <!-- Menu Right -->
    <div class="menu hidden md:flex">
      {
        navItems
          .map(({ title, url }) => (
            <a
              class="group shrink-0 px-4 py-2  font-semibold leading-6 text-primary-700 duration-300"
              href={url}>
              {title}
              <span
                class:list={[
                  "block max-w-0 group-hover:max-w-full transition-all duration-500 h-1 bg-secondary-600",
                  activePage == url ? "max-w-full" : "",
                ]}
              />
            </a>
          ))
          .slice(2, 5)
      }
    </div>

    <!-- hamburger button -->
    <div class="flex md:hidden">
      <button
        id="open-nav-btn"
        type="button"
        class="-p-2.5 inline-flex items-center justify-center rounded-full p-2.5 text-gray-700 bg-primary-800">
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-6 w-6 fill-current text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5">
          </path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu, show/hide based on menu open state. -->
    <div
      id="menu-mobile"
      class="hidden md:hidden"
      role="dialog"
      aria-modal="true">
      <!-- Background backdrop, show/hide based on slide-over state. -->
      <!-- <div class="fixed  inset-0 z-20"></div> -->
      <div
        class="fixed inset-y-0 right-0 z-20 w-full bg-primary-900 px-3 py-6 sm:ring-1 sm:ring-gray-900/10">
        <div class="flex items-center pt-[16px] justify-end">
          <button
            id="close-nav-btn"
            type="button"
            class="rounded-md text-white">
            <span class="sr-only">Close menu</span>
            <svg
              class="h-8 w-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12">
              </path>
            </svg>
          </button>
        </div>
        <div class="mt-6 flow-root sm:px-10">
          <ul class="py-6">
            <li
              class="block px-4 py-2 font-semibold text-white border-b border-primary-500/50">
              <a href={withBase("/")} class="-m-3">Home</a>
            </li>
            {
              navItems.map(({ title, url }) => (
                <li class="px-3 py-3 border-b border-primary-500/50 font-semibold text-white hover:delay-100 hover:bg-primary-500/20">
                  <a href={url}>{title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenu = () => {
    const menu = document.querySelector("#menu-mobile");
    const mainBody = document.querySelector("#main-body");
    const openNavButton = document.querySelector("#open-nav-btn");
    const closeNavButton = document.querySelector("#close-nav-btn");

    const toggleMenu = () => {
      menu!.classList.toggle("hidden");
      mainBody!.classList.toggle("overflow-hidden");
    };

    openNavButton!.addEventListener("click", toggleMenu);
    closeNavButton!.addEventListener("click", toggleMenu);
  };

  //Runs on initial nav
  mobileMenu();
  //Runs on view transition nav
  document.addEventListener("astro:after-swap", mobileMenu);
</script>

<script></script>
