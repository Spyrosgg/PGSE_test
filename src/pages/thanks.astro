---
import { withBase } from "../lib/url.js";
import { Icon } from "astro-icon/components";
import { Image } from 'astro:assets';
import {  SITE_TITLE_HEADER } from "../consts";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import Spacer from "../components/ui/spacer.astro";
import SpacerHalf from "../components/ui/spacer-half.astro";
import Btn from "../components/ui/btn.astro"

---

<Layout title="Thank you">
  <Container>
    <Spacer/>
    <div class="flex flex-col items-center gap-4">
      <h1 class="max-w-xl text-4xl">Thank you for your inquiry!</h1>
      <p class="text-primary-600">
        The right team member will reach out to you promptly.
      </p>
      <SpacerHalf/>
      <!-- return btn  -->
      <Btn text="← Back to Home" link={withBase("/")} />
      <!-- <div class="text-center">
        <a
          href={withBase("/")}
          class="bg-primary-100 hover:bg-primary-200 rounded-md px-5 py-3 transition"
          >← Back to Home</a
        >
      </div> -->
    </div>
    <Spacer/>
  </Container>
</Layout>
