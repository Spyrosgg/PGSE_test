---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { SITE_TITLE_HEADER } from "../consts";
import { SITE_MAIN_DESCRIPTION } from "../consts";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import Spacer from "../components/ui/spacer.astro";
import SpacerHalf from "../components/ui/spacer-half.astro";
import ServicesBase from "../components/services/service-base-component.astro";
import ServicesReact from "../components/services/service-react-component.astro";

import Sectors from "../components/index/SS_sectors.astro";
import BtnServices from "../components/ui/btn-services.astro";
import BtnContact from "../components/ui/btn-contact.astro";
import structimg from "../images/ptrn-girders.jpeg";
import civilimg from "../images/bird-view.jpeg";
import bimimg from "../images/bim-metro.jpeg";
import consimg from "../images/green-facade.jpeg";

import {
  servicesEngineeringData,
  servicesDesignData,
  servicesConsultancyData,
} from "../consts";

const serviceItemsEng = [
  { service: "Design of buildings, bridges, and tunnels" },
  { service: "Design of sustainable structures" },
  {
    service:
      "Design of reinforced concrete, steel, timber, masonry, and compositestructures",
  },
  { service: "Design of prestressed and post-tensioned concrete structures" },
  { service: "Seismic design of structures" },
  { service: "Blast resistant design" },
  { service: "Inspection and assessment of structures" },
  { service: "Strengthening of existing structures" },
  { service: "Design of temporary works" },
];
const serviceItemsDng = [
  { service: "BIM modelling" },
  { service: "Finite Element modelling (FEM)" },
  { service: "Parametric design" },
  { service: "3D modelling" },
  { service: "CAD drawings" },
  { service: "Clash detection" },
];
const serviceItemsCon = [
  { service: "Expert advice and guidance" },
  { service: "Technical support" },
  { service: "Peer review and design checks" },
  { service: "Coordination of multi-disciplinary teams" },
  { service: "Value engineering" },
  { service: "Strategic BIM advice" },
  { service: "BIM Execution Plans (BEP)" },
  { service: "Client-specific BIM strategy" },
  { service: "Embodied carbon assessment" },
];
const serviceItemsCiv = [
  { service: "Sustainable Drainage Strategies" },
  { service: "Strategic infrastructure advice and Master-planning" },
  { service: "Site-wide level design" },
  {
    service:
      "Our civil engineering services encompass site development, grading, drainage, and utility design for both residential and commercial projects.",
  },
];
---

<Layout title="Our services" description={SITE_MAIN_DESCRIPTION}>
  <Container>
    <!-- <Spacer /> -->
    <p class="pt-10">
      At <span class="font-bold">{SITE_TITLE_HEADER}</span>, we offer a wide
      range of professional services in the field of structural and civil
      engineering, as well as cutting-edge BIM (Building Information Modeling)
      and 3D modeling solutions. Our expert team is dedicated to delivering
      innovative and reliable solutions tailored to meet your project's specific
      needs.
    </p>
    <!-- <p>
      We specialise in structural the design and analysis. Our team
      employs advanced software and techniques to develop safe, efficient,
      and cost-effective structural designs.
    </p> -->
    <Spacer />
    <div class="flex flex-col justify-center">
      <ServicesBase
        picture={structimg}
        type="Engineering"
        alt="engineering-img"
        reverse={false}
        servicesItems={serviceItemsEng}
      />
      <SpacerHalf />
      <ServicesBase
        picture={bimimg}
        type="Design"
        alt="design-img"
        reverse={true}
        servicesItems={serviceItemsDng}
      />
      <SpacerHalf />
      <ServicesReact
        picture={consimg}
        type="Consultancy"
        alt="consultancy-img"
        reverse={false}
        servicesItems={servicesConsultancyData}
      />

      <Spacer />
      <div>
        At <span class="font-bold">{SITE_TITLE_HEADER}</span>, we are motivated
        by the chance to make a difference in people's lives and improve their
        communities. We take satisfaction in creating infrastructure that
        enhances quality of life, promotes sustainability, and contributes to
        economic growth.
      </div>

      <SpacerHalf />
      <h1 class="mb-8 text-2xl">
        We offer a range of services in various sectors
      </h1>
      <Sectors tab="hidden" />

      <Spacer />
      <div>
        <div class="min-w-[220px] text-5xl">Discover the Difference</div>
        <!-- btns -->
        <div
          class="flex flex-none items-end gap-4 pt-2 sm:flex-col sm:max-lg:items-start sm:max-lg:gap-2 lg:flex-row"
        >
          <!-- <BtnServices /> -->
          <BtnContact />
        </div>
      </div>
      <Spacer />
    </div>
  </Container>
   ../components/react/Accordion.jsx
</Layout>
../components/react/Accordion2