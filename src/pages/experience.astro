---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE_TITLE_HEADER } from "../consts";
import { SITE_MAIN_DESCRIPTION } from "../consts";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import birdView from "../images/bird-view.jpeg";
import Spacer from "../components/ui/spacer.astro";

// Get collection
import { getCollection } from "astro:content";
const projectPosts = await getCollection("projects", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
projectPosts.sort(function (a, b) {
  return a.data.sortOrder.valueOf() - b.data.sortOrder.valueOf();
});
---

<Layout title="Experience" description={SITE_MAIN_DESCRIPTION}>
  <main>
    <Container>
      <!-- Line below header -->
      <!-- <div class="relative flex flex-col items-center">
      <div
        class="absolute flex justify-center -top-[58px] h-[58px] md:-top-[42px] md:h-[42px] w-screen bg-primary-200/50 -z-10"
      >
      </div>
    </div> -->

    <!-- Page hero image -->
      <!-- <div class="mt-2 overflow-hidden">
        <Image
          class="w-full h-96 lg:h-[60vh] object-cover rounded-2xl"
          src={birdView}
          width={1080}
          alt="bird-view"
        />
      </div> -->

      <div class="relative">
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <div class="text-4xl font-semibold">Our Experience</div>
            <p class="max-w-[280px] font-normal">
              Projects the team members have worked on.
            </p>
          </div>
          <div>
            Our diverse experience is the result of over two decades of
            dedicated effort and innovation. We've undertaken projects across a
            broad range of sectors, including building, transportation, utility,
            and tailored structures. Equally, our clients and collaborators are
            diverse, encompassing individuals, developers, companies, and
            government agencies.
          </div>
        </div>

        <h1 id="projects" class=" mt-24 border-b-2 text-3xl font-semibold">
          Projects
        </h1>
        <ul>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              projectPosts.map((project, index) => (
                <li>
                  <a href={`/projects/${project.id}`}>
                    <Image
                      src={project.data.cover}
                      alt={project.data.coverAlt}
                      width={800}
                      class="w-full rounded-md"
                    />
                    <h2 class="text-xl">{project.data.title}</h2>
                    <p class="text-sm">{project.data.description}</p>
                    <a href={`/projects/${project.id}`}>Read more</a>
                  </a>
                </li>
              ))
            }
          </div>
        </ul>
        <article>
          <a class="flex flex-col items-center" href=""></a>
        </article>
      </div>
      <div class="text-primary-600 mt-32 text-xl">...More on the way!</div>
      <Spacer />
    </Container>
  </main>
</Layout>
