---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import { SITE_TITLE_HEADER, EMAIL } from "../consts";
import { SITE_MAIN_DESCRIPTION } from "../consts";

import escalator from "../images/eliz-line.jpeg";
import Spacer from "../components/ui/spacer.astro";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
---

<Layout title="Contact us" description={SITE_MAIN_DESCRIPTION}>
  <Container>
    <div class="pt-2 flex justify-center overflow-hidden">
      <Image
        class="h-96 lg:h-[60vh] w-full object-cover rounded-2xl"
        src={escalator}
        height={1080}
        alt="Escalator"
      />
    </div>

    <div class="isolate bg-white px-6 py-0 sm:pt-0 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <h2
          class="mt-12 text-3xl font-bold tracking-tight text-primary-900 sm:text-4xl">
          Contact
        </h2>
        <p class="mt-2 text-primary-600">
          We appreciate your interest in <span class="font-semibold">{SITE_TITLE_HEADER}</span>, and we look forward to discussing your project needs. Whether
          you have questions, need a consultation, or want to collaborate with
          us on your next venture, we are here to assist you.
        </p>
        <p class="pt-8 text-lg">
          To start a conversation about your project, ask a question, or simply
          say hello, drop us an email.
        </p>
        <div
          class="m-auto mt-8 flex justify-center overflow-hidden bg-secondary-600 px-4 py-10 text-xl font-semibold text-white">
          <div class="EMAIL flex flex-col items-center gap-1 md:gap-4">
            <div class="flex gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-6 w-6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75">
                </path>
              </svg>
              <p class="">Email</p>
            </div>
            <a href={`mailto:info@${EMAIL}`} class="border-b-2 text-xl">
              info@{EMAIL}
            </a>
          </div>
        </div>
      </div>
    </div>
    <Spacer />
  </Container>
</Layout>
