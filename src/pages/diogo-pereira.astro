---
import { withBase } from "../lib/url.js";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import portrait from "../images/profiles/DiogoLarge.jpeg";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import Spacer from "../components/ui/spacer.astro";
import Btn from "../components/ui/btn.astro";

import { SITE_TITLE_HEADER, OFFICIAL_TITLE, EMAIL } from "../consts";
import SpacerHalf from "../components/ui/spacer-half.astro";
const SITE_TITLE_UPP = SITE_TITLE_HEADER.toUpperCase();
---

<Layout title="Diogo Pereira Bio">
  <Container>
    <div class="relative flex flex-col items-center">
      <!-- bg-black section -->
      <div class="absolute -z-50 bg-primary-900 w-screen h-full"></div>
      <div class="flex flex-col items-center h-full">
        <Spacer />
        <!-- top layer behind header circle -->
        <div
          class="absolute flex justify-center -top-[58px] h-[58px] md:-top-[42px] md:h-[42px] w-screen bg-primary-100 -z-10">
        </div>

        <div class="flex flex-col text-white items-center max-w-7xl">
          <div
            class="flex flex-col-reverse lg:flex-row shrink gap-8 items-center lg:items-start">
            <div class="max-w-lg">
              <h1 class="font-semibold text-4xl">Diogo Pereira</h1>
              <h2 class="pt-3 pb-6 text-lg">
                Partner • Civil & Structural Engineer, CEng MICE
              </h2>

              <section>
                <p class="pt-4">
                  Diogo is an engineer with extensive experience in the
                  structural design of buildings, bridges, and tunnels. His
                  expertise include the design of reinforced concrete, steel,
                  masonry, and timber structures, as well as the seismic design
                  of structures. Diogo is chartered with the Institution of
                  Civil Engineers (UK) and with the Ordem dos Engenheiros
                  (Portugal).
                </p>

                <p class="pt-4">
                  After completing a master's degree in civil engineering, Diogo
                  started his career in 2010 working for GAPRES in Lisbon.
                  During this time, he played a pivotal role in the design of
                  several structures in Portugal such as railway viaducts for
                  the Northern Line, the Alcantara Railway Tunnel, overpasses
                  and underpasses for the A17 Highway, and the Dolce Vita Braga
                  shopping centre. In GAPRES, he specialised in the seismic
                  design of reinforced concrete and post tensioned structures.
                </p>

                <p class="pt-4">
                  In 2012, Diogo joined Quadrante Engineering in Lisbon, where
                  he participated in the design of several structures in Brazil
                  such as the new Terminals of Fortaleza Airport, highway
                  viaducts for the Cafezal Ridge, and highway viaducts in São
                  Paulo. In Quadrante Engineering, Diogo specialised in the
                  parametric design of structures as a mean of achieving
                  elevated levels of productivity and operational efficiency.
                </p>

                <p class="pt-4">
                  Diogo's professional journey took him to the role of design
                  manager for the construction of utilities infrastructure in
                  the city of Kuwayfiyah, Libya. This experience proved
                  invaluable to develop skills such as the coordination of teams
                  across diverse disciplines and cultures, as well as
                  establishing robust relationships with clients and
                  stakeholders to enhance the delivery of value in projects.
                </p>

                <p class="pt-4">
                  In 2014, Diogo embarked on a new chapter with Atkins in
                  London, where he led multidisciplinary design teams in
                  high-profile projects including HS2, Crossrail, London City
                  Airport, and Birmingham New Street Station. Diogo has actively
                  championed the quality assurance of deliverables, instituting
                  checking procedures for in-house and third-party designs,
                  while training and developing people. In Atkins, Diogo
                  specialised in the design of steel, masonry, and timber
                  structures.
                </p>

                <p class="pt-4">
                  In 2022, the culmination of his diverse experiences led Diogo
                  to venture into independent consultancy and to the inception
                  of {OFFICIAL_TITLE} (<span class="font-semibold">{SITE_TITLE_HEADER}</span>).
                </p>
              </section>

              <SpacerHalf />
              <Btn text="← Go back" link={withBase("/about#meet-our-team")} />
            </div>

            <div class="h-auto overflow-hidden shrink-0">
              <img
                class="object-cover"
                src={portrait.src}
                width={448}
                alt="Diogo P"
              />
              <SpacerHalf />

              <h3 class="text-xl font-semibold">Contacts</h3>
              <ul class="list-none">
                <li class="mt-2">
                  <a href=`mailto:diogo@pgse.co.uk` class="border-b-2">
                    diogo@{EMAIL}
                  </a>
                </li>
                <li class="mt-2">
                  <a
                    href="https://www.linkedin.com/in/d10gopereira/"
                    target="_blank"
                    rel="noopener noreferrer">
                    <Icon
                    name="ri:linkedin-box-fill"
                    class="h-8 w-8"
                  />
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <Spacer />
      </div>
    </div>
  </Container>
</Layout>
