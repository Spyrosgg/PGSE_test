---
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import Spacer from "../components/ui/spacer.astro";
---

<!--
  This example requires updating your template:

  ```
  <html class="h-full">
  <body class="h-full">
  ```
-->
<Layout title="404">
  <Container>
    <Spacer />
    <div class="bg-white grid min-h-full place-items-center px-6 lg:px-8">
      <div class="text-center">
        <p class="text-xl font-semibold text-secondary-600">404</p>
        <h1
          class="text-primary-900 mt-4 text-3xl font-bold tracking-tight sm:text-5xl">
          Page not found
        </h1>
        <p class="text-primary-600 mt-6 leading-7 text-base">
          Sorry, we couldn't find the page you're looking for.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a
            href="/"
            class="text-white rounded-full bg-secondary-600 px-3.5 py-2.5 text-sm font-semibold shadow-sm hover:bg-secondary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-600"
            >Go back home</a
          >
          <a href="/contact" class="text-primary-900 text-sm font-semibold"
            >Contact us <span aria-hidden="true">&rarr;</span></a
          >
        </div>
      </div>
    </div>
    <Spacer />
  </Container>
</Layout>
