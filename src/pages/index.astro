---
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";

import Hero from "../components/index/hero_v1_active.astro";
import Sectors from "../components/index/sectors_index.astro";
import MeetTheTeamSmall from "../components/index/meetTeamSmall.astro";
import CTA from "../components/index/CTA.astro";
import Discover from "../components/discover-difference.astro";
import Spacer from "../components/ui/spacer.astro";
import SpacerHalf from "../components/ui/spacer-half.astro";
import BtnServices from "../components/ui/btn-services.astro";
import BtnContact from "../components/ui/btn-contact.astro";

import { SITE_TITLE_HEADER } from "../consts";
const SITE_TITLE_UPP = SITE_TITLE_HEADER.toUpperCase();
import { SITE_MAIN_DESCRIPTION } from "../consts";
---

<Layout title="Home Page" description={SITE_MAIN_DESCRIPTION}>
  <main>
    <Hero />
    <SpacerHalf />
    <Container>
      <!-- MAIN -->
      <div class="flex flex-col justify-around gap-6 sm:flex-row">
        <h1 class="min-w-[160px] text-4xl">Better by design</h1>
        <p class="sm:max-w-md">
          At <span class="font-display font-bold">{SITE_TITLE_HEADER}</span>, we
          provide a comprehensive range of structural engineering services,
          enhanced by cutting-edge digital solutions. With our expertise,
          experience, and commitment to excellence, we ensure that each
          structural design we deliver will endure the test of time, offering
          you a solid foundation for success.
        </p>
      </div>

      <Spacer />
      <Sectors tab="" />

      <Spacer />
      <div
        class="flex flex-col-reverse justify-around gap-8 sm:flex-row sm:gap-6">
        <div>
          <p class="sm:max-w-md">
            When you choose <span class="font-bold">{SITE_TITLE_HEADER}</span>
             to assist you with your engineering, design, and consultancy needs,
            you can expect more than just technical expertise. You gain a
            dedicated partner who is invested in your success and committed to
            delivering results that exceed your expectations.

            <!-- Our experts collaborate
            seamlessly, infusing enthusiasm into each project, regardless of their
            scale or complexity. Contact PGSE to create something exceptional,
            together. Your vision, our expertise, a brighter future. -->
          </p>
        </div>

        <div>
          <div class="min-w-[220px] text-2xl">Discover the Difference</div>
          <!-- btns -->
          <div
            class="flex flex-none items-end gap-4 pt-2 sm:flex-col sm:gap-0 md:gap-4 md:flex-row sm:items-start md:items-end lg:flex-row">
            <BtnServices />
            <BtnContact />
          </div>
          <p class="pt-4 hidden md:block">
            Your vision, our expertise, a brighter future.
          </p>
        </div>
      </div>

      <Spacer />
      <MeetTheTeamSmall />

      <Spacer />
    </Container>
    <CTA />
  </main>
</Layout>
