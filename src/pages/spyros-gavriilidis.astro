---
import { withBase } from "../lib/url.js";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import portrait from "../images/profiles/SpyrosLarge448.jpeg";
import Layout from "../Layout/BaseLayout.astro";
import Container from "../components/container.astro";
import Spacer from "../components/ui/spacer.astro";
import Btn from "../components/ui/btn.astro";

import { SITE_TITLE_HEADER, OFFICIAL_TITLE, TEL_UK, EMAIL } from "../consts";
import SpacerHalf from "../components/ui/spacer-half.astro";
const SITE_TITLE_UPP = SITE_TITLE_HEADER.toUpperCase();
---

<Layout title="Spyros Gavriilidis Bio">
  <Container>
    <div class="relative flex flex-col items-center">
      <!-- bg-black section -->
      <div class="absolute -z-50 bg-primary-900 w-screen h-full"></div>
      <div class="flex flex-col items-center h-full">
        <Spacer />
        <!-- top layer behind header circle -->
        <div
          class="absolute flex justify-center -top-[58px] h-[58px] md:-top-[42px] md:h-[42px] w-screen bg-primary-100 -z-10">
        </div>

        <div class="flex flex-col text-white items-center max-w-7xl">
          <div
            class="flex flex-col-reverse lg:flex-row shrink gap-8 items-center lg:items-start">
            <div class="max-w-lg">
              <h1 class="font-semibold text-4xl">Spyros Gavriilidis</h1>
              <h2 class="pt-3 pb-6 text-lg">
                Partner • Civil & Structural Engineer, CEng MICE
              </h2>
              <section>
                <!-- <h3 class="pt-6 font-semibold">Key experience</h3>
                <ul class="list-disc pl-6">
                  <li>
                    Steel, concrete, masonry and timber design to British
                    Standards and Eurocodes.
                  </li>
                  <li>Design of prefabricated modular construction systems.</li>
                  <li>Refurbishment and regeneration of existing structures</li>
                  <li>Experience in Seismic and Blast design.</li>
                  <li>Structures BIM manager.</li>
                  <li>Algorithm/ Software Automation development.</li>
                  <li>Multidisciplinary design management and coordination</li>
                </ul> -->

                <p class="pt-4">
                  Spyros is a chartered civil and structural engineer with
                  extensive experience in the design of high-rise, retail and
                  commercial buildings, rail, educational, healthcare, and
                  residential projects. Proficient in BIM technology, he
                  constantly seeks opportunities to enhance efficiency through
                  technological advancements. He also possesses a creative side,
                  which has driven him to collaborate closely with architects
                  and gain an appreciation for the intricate conceptual aspects
                  of architectural projects.
                </p>
                <p class="pt-4">
                  With over a decade of experience, he has established a
                  prominent presence within the industry, holding chartership in
                  three countries: the UK Institution of Civil Engineers (ICE),
                  the Technical Chamber of Greece (TEE), and the Cyprus
                  Scientific and Technical Chamber (ΕΤΕΚ).
                </p>
                <p class="pt-4">
                  Spyros's passion for mathematics and problem-solving led him
                  to study engineering at the University of Patras. After
                  graduation, he worked with Domenica Group in Cyprus, gaining
                  valuable experience in residential building design and site
                  supervision. In 2013, he moved to UK and joined Atkins in
                  Colchester. His introduction to BIM technology and his love
                  for innovation sparked his journey to become proficient and a
                  digital leading figure in the company. He quickly assumed a
                  leading role in the structural engineering team and worked
                  closely with architects. In 2016, Spyros relocated to Atkins'
                  London office, contributing to major projects such as the
                  Crossrail (Elizabeth Line) and the redevelopment of Croydon
                  station, where he led the structural design of the station and
                  high-rise commercial buildings.
                </p>

                <p class="pt-4">
                  His entrepreneurial spirit and desire for creative autonomy
                  led to the establishment of {OFFICIAL_TITLE} (<span class="font-semibold">{SITE_TITLE_HEADER}</span>) in 2022.
                </p>
              </section>

              <SpacerHalf />
              <Btn text="← Go back" link={withBase("/about#meet-our-team")} />
            </div>

            <div class="h-auto overflow-hidden shrink-0">
              <img
                class="object-cover"
                src={portrait.src}
                width={448}
                alt="Spyros G"
              />
              <SpacerHalf />
              <h3 class="text-xl font-semibold">Contacts</h3>
              <ul class="list-none">
                <li class="mt-2">
                  <a href=`mailto:spyros@pgse.co.uk` class="border-b-2">
                    spyros@{EMAIL}
                  </a>
                </li>
                <li class="mt-2"><a href={`tel:+44${TEL_UK}`}>+44 {TEL_UK}</a></li>
                <li class="mt-2">
                  <a
                    href="https://www.linkedin.com/in/spyrosgavriilidis"
                    target="_blank"
                    rel="noopener noreferrer">
                    <Icon name="ri:linkedin-box-fill" class="h-8 w-8" />
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <Spacer />
      </div>
    </div>
  </Container>
</Layout>
