---
import "../styles/base.css";
import Header from "../components/navbar/header.astro";
import Footer from "../components/footer.astro";
import Head from "../components/head.astro";
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full motion-safe:scroll-smooth">
  <Head />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7XSVP54V5W"
  ></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-7XSVP54V5W");
  </script>

  <body
    class="bg-default text-default selection:bg-primary-800 selection:text-white h-screen overflow-x-hidden text-base"
  >
    <Header />
    <main class="relative m-auto mt-16 max-w-7xl px-4 sm:px-16 md:px-24">
      <h1>{frontmatter.title}</h1>
      <h2>Member: {frontmatter.member}</h2>
      <p>{frontmatter.description}</p>

      <slot />
    </main>
    <Footer />
  </body>
</html>
