---
import Header from "../components/navbar/header2-dark._active.astro";
import Footer from "../components/footer.astro";
import "../styles/base.css";
import Head from "../components/head.astro";
const { title, description } = Astro.props;

---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <Head  title={title} description={description}/>
  <!-- <title>{title}</title> -->
  <body
    id="main-body"
    class="h-screen overflow-x-hidden text-base selection:bg-primary-800 selection:text-white"
  >
    <Header title={title}/>
    <slot />
    <Footer />
  </body>
</html>
